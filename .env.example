VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# EmailJS configuration for the contact form
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# GitHub — the portfolio reads the data/ mirror from this repo when Supabase is
# paused/unavailable. Read-only: never put a GitHub token in a VITE_ variable
# (it would be bundled into the public JS). The mirror is written by the
# .github/workflows/sync-data.yml Action instead.
VITE_GITHUB_OWNER=rhbntm
VITE_GITHUB_REPO=portfolio-cms
VITE_GITHUB_BRANCH=main

# Where public pages read content from: unset = Supabase with GitHub fallback,
# "github" = only the data/ mirror (use once Supabase is shut down).
# VITE_DATA_SOURCE=github

# PostHog Analytics
VITE_POSTHOG_KEY=your_posthog_project_api_key
VITE_POSTHOG_HOST=https://us.i.posthog.com