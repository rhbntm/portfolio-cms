VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# EmailJS configuration for the contact form
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# GitHub — used to mirror data/posts.json & data/projects.json to the repo.
# The portfolio reads from GitHub when Supabase is paused/unavailable.
VITE_GITHUB_TOKEN=your_github_pat
VITE_GITHUB_OWNER=rhbntm
VITE_GITHUB_REPO=portfolio-cms
VITE_GITHUB_BRANCH=main
